<?xml version="1.0" encoding="utf-8"?>
<!--
  Root is a branded FrameLayout so the status-bar / navigation-bar strips (which
  the WebView is inset away from on Android 15 edge-to-edge) show the brand
  colour instead of transparent black. The content layer (swipeRefresh) is
  padded by the system-bar + IME insets in MainActivity so the web header never
  slides under the status bar and the chat input never hides behind the keyboard.
  The splashOverlay sits on top, edge-to-edge, and fades out once the page loads.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_night">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/brand_night" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:max="100"
                android:progress="0"
                android:visibility="gone"
                android:progressTint="@color/brand_accent" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Animated splash overlay: brand background, logo, and a "connecting"
         indicator. Covers the full screen (incl. system bars) for a seamless
         hand-off, then fades away in MainActivity when the page is ready. -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/brand_night"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/falcon_logo"
                tools:ignore="ImageContrastCheck" />

            <TextView
                android:id="@+id/splashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.06"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splashTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.7"
                android:text="@string/splash_tagline"
                android:textColor="@color/brand_muted"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/splashProgress"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="26dp"
                android:indeterminateTint="@color/brand_accent" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
