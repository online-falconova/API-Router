<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground = the brand logo, inset so it sits inside the
     safe zone (center ~60%) and never gets clipped by the launcher mask. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/falcon_logo"
    android:insetLeft="20%"
    android:insetTop="20%"
    android:insetRight="20%"
    android:insetBottom="20%" />
